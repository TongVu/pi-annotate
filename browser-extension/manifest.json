{
  "manifest_version": 3,
  "name": "Pi Chat Tab Switcher",
  "version": "0.1.0",
  "description": "Focus an existing local Pi Chat tab without reloading its draft.",
  "key": "",
  "host_permissions": ["http://127.0.0.1/*"],
  "externally_connectable": { "matches": ["http://127.0.0.1/*"] },
  "background": { "service_worker": "switch-tab.js" }
}
